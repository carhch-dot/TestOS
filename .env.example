# Copy this file to apps/api/.env for local development.
# All values here are examples only — never commit real credentials.

# Postgres connection string used by the API and Prisma (apps/api).
DATABASE_URL="postgresql://user:password@localhost:5432/testos?schema=public"

# Credentials for the first Administrator account. Required only when the
# Usuario table is empty: on first startup the API creates exactly one
# Administrator from these values and hashes the password with argon2. The
# API fails fast, naming the missing variable, if either is unset while the
# database has zero users.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
