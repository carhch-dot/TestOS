# Copy this file to apps/api/.env for local development.
# All values here are examples only — never commit real credentials.

# Postgres connection string used by the API and Prisma (apps/api).
DATABASE_URL="postgresql://user:password@localhost:5432/testos?schema=public"

# Credentials for the first Administrator account. Required only when the
# Usuario table is empty: on first startup the API creates exactly one
# Administrator from these values and hashes the password with argon2. The
# API fails fast, naming the missing variable, if either is unset while the
# database has zero users.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Secret used to sign/verify JWT access tokens issued by POST /auth/login.
# Use a long, random value in real environments — never commit a real secret.
JWT_SECRET="change-me-to-a-long-random-value"

# Temporary lockout after repeated failed login attempts (FR2). After this
# many consecutive wrong-password attempts on the same account, it is locked
# for the configured duration and a lockout email is sent (best-effort).
LOGIN_LOCKOUT_MAX_ATTEMPTS=3
LOGIN_LOCKOUT_DURATION_MINUTES=30

# How long a POST /auth/invite activation token stays valid before it must be
# reissued (a Manager/Administrator re-inviting a still-PENDING_VERIFICATION
# user does this automatically).
INVITATION_TOKEN_TTL_DAYS=7

# Generic SMTP transport for MailModule, the shared outbound-email service
# (AD-9). No provider has been chosen yet (deployment decision) — leave
# SMTP_HOST unset to skip sending mail entirely (logged, no connection
# attempted); MAIL_TIMEOUT_MS bounds how long a send may take before it is
# logged and swallowed instead of blocking the caller.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="no-reply@example.com"
MAIL_TIMEOUT_MS=5000

# Bounds on GET /topology/:itemId/tree's breadth-first traversal (FR23/
# FR26) — how many hops out from the root item to explore, and the total
# node count at which the response is capped (truncated: true) rather than
# attempting to render everything. GET /topology/:itemId/neighbors ignores
# TOPOLOGY_MAX_DEPTH (it is always exactly 1 hop) but still respects
# TOPOLOGY_MAX_NODES.
TOPOLOGY_MAX_DEPTH=5
TOPOLOGY_MAX_NODES=5000
