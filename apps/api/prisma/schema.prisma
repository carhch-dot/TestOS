// Prisma schema for TestOS API.
// AuthModule is the only module that writes Usuario (AD-1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UsuarioRole {
  ADMINISTRATOR
  MANAGER
  EDITOR
  READ_ONLY
}

enum UsuarioStatus {
  ACTIVE
  PENDING_VERIFICATION
  DEACTIVATED
}

model Usuario {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  role         UsuarioRole
  status       UsuarioStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
}
