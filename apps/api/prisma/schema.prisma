// Prisma schema for TestOS API.
// AuthModule is the only module that writes Usuario (AD-1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UsuarioRole {
  ADMINISTRATOR
  MANAGER
  EDITOR
  READ_ONLY
}

enum UsuarioStatus {
  ACTIVE
  PENDING_VERIFICATION
  DEACTIVATED
}

model Usuario {
  id                     String               @id @default(uuid())
  email                  String               @unique
  passwordHash           String
  role                   UsuarioRole
  status                 UsuarioStatus        @default(ACTIVE)
  // Lockout after failed attempts (FR2): a running counter + a lock-until
  // timestamp, no separate attempt-history table (see spec Boundaries).
  failedLoginAttempts    Int                  @default(0)
  lockedUntil            DateTime?
  // Capped history of prior real password hashes, most-recent first (FR11 /
  // spec-1-11): pushed onto only when `PasswordResetService.confirmReset`
  // replaces a real password, sliced to `PASSWORD_HISTORY_COUNT`. Not a
  // separate table (see spec-1-11 Design Notes) — small, bounded, no
  // independent lifecycle.
  previousPasswordHashes String[]             @default([])
  createdAt              DateTime             @default(now())
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  invitationTokens       InvitationToken[]
}

// Persists only the SHA-256 hash of each issued refresh token (AD-5); the raw
// value is returned to the client once at issuance and never stored.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  usuario   Usuario  @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Persists only the SHA-256 hash of each issued password-reset token (same
// posture as RefreshToken above); the raw value is emailed to the user once
// and never stored. A row is created only for a real ACTIVE-user match
// (spec-1-6) — `forgot-password` never creates one for an unknown email or a
// non-ACTIVE account.
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  usuario   Usuario  @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Persists only the SHA-256 hash of each issued invitation/activation token
// (same shape and posture as PasswordResetToken above); the raw value is
// emailed once and never stored. Created on invite, and re-created (with the
// prior unused row invalidated) when a still-PENDING_VERIFICATION user is
// re-invited (spec-1-7) — no duplicate Usuario row on resend.
model InvitationToken {
  id        String   @id @default(uuid())
  userId    String
  usuario   Usuario  @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
